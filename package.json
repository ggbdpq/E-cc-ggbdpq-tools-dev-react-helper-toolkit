{
  "name": "react-hooks-me",
  "version": "0.1.0",
  "description": "React Hooks 与 TypeScript 常用工具集，UI 无关，零运行时依赖",
  "keywords": [
    "react",
    "hooks",
    "utils",
    "typescript"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.mts",
      "import": "./dist/utils/*.mjs",
      "require": "./dist/utils/*.js"
    },
    "./browser/*": {
      "types": "./dist/browser/*.d.mts",
      "import": "./dist/browser/*.mjs",
      "require": "./dist/browser/*.js"
    },
    "./node/*": {
      "types": "./dist/node/*.d.mts",
      "import": "./dist/node/*.mjs",
      "require": "./dist/node/*.js"
    },
    "./echarts": {
      "types": "./dist/echarts/index.d.mts",
      "import": "./dist/echarts/index.mjs",
      "require": "./dist/echarts/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run && tsup"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.0",
    "jsdom": "^25.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
